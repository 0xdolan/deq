{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0xdolan.github.io/deq/spec/schema/grid.schema.json",
  "title": "Deq design grid",
  "type": "object",
  "additionalProperties": false,
  "required": ["canvas", "padding", "liveArea", "decimals", "defaults", "keylines"],
  "properties": {
    "$schema": { "type": "string" },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "origin"],
      "properties": {
        "width": { "const": 24 },
        "height": { "const": 24 },
        "origin": { "const": "top-left" }
      }
    },
    "padding": { "type": "number", "minimum": 0 },
    "liveArea": {
      "description": "[x, y, width, height]. The visual extent of every shape (stroke edges and dot edges) stays inside it.",
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "decimals": { "type": "integer", "minimum": 0, "maximum": 6 },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strokeWidth", "linecap", "linejoin", "fill", "stroke", "dotRadius"],
      "properties": {
        "strokeWidth": { "type": "number", "exclusiveMinimum": 0 },
        "linecap": { "enum": ["round", "butt", "square"] },
        "linejoin": { "enum": ["round", "miter", "bevel"] },
        "fill": { "type": "string" },
        "stroke": { "type": "string" },
        "dotRadius": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "keylines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "shape"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "description": { "type": "string" },
          "shape": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "cx", "cy", "r"],
                "properties": {
                  "type": { "const": "circle" },
                  "cx": { "type": "number" },
                  "cy": { "type": "number" },
                  "r": { "type": "number", "exclusiveMinimum": 0 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "x", "y", "width", "height"],
                "properties": {
                  "type": { "const": "rect" },
                  "x": { "type": "number" },
                  "y": { "type": "number" },
                  "width": { "type": "number", "exclusiveMinimum": 0 },
                  "height": { "type": "number", "exclusiveMinimum": 0 }
                }
              }
            ]
          }
        }
      }
    }
  }
}
