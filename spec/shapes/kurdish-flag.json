{
  "$schema": "../schema/shape.schema.json",
  "id": "kurdish-flag",
  "version": 2,
  "category": "kurdish-symbols",
  "names": {
    "en": "Flag of Kurdistan",
    "ckb": {
      "text": "ئاڵای کوردستان",
      "status": "needs-native-review",
