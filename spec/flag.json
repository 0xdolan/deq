        "strokeToHeight": 0.01
      }
    },
    {
      "id": "high-contrast",
      "description": "Full colour with a thin black outline round the sun and the flag, for low-vision and busy backgrounds.",
      "aspectRatio": "3:2",
      "paint": {
        "field": "white",
        "bands": "flag-colors",
        "dividers": "none",
        "frame": "black",
        "sun": "yellow",
        "sunOutline": "black",
        "strokeToHeight": 0.005
      }
    },
    {
      "id": "square",
      "description": "A 1:1 crop for avatars and app icons: bands and sun keep their sizes relative to the height, the sides are trimmed.",
      "aspectRatio": "1:1",
      "paint": {
        "field": "white",
        "bands": "flag-colors",
        "dividers": "none",
        "frame": "none",
        "sun": "yellow"
      }
    }
  ],
  "sizes": [
