    {
      "id": "yellow",
      "name": "Yellow",
      "kurdish": { "kmr": "zer", "status": "needs-native-review" },
      "hex": "#FEBD11",
      "rgb": [254, 189, 17],
      "hsl": [43.5, 99.2, 53.1],
      "oklch": [0.836, 0.169, 83.1],
      "cmyk": [0, 26, 93, 0],
