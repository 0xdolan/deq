  "bands": [
    { "color": "red", "y": 0, "height": 200 },
    { "color": "white", "y": 200, "height": 200 },
    { "color": "green", "y": 400, "height": 200 }
  ],
  "sun": {
    "color": "yellow",
    "rays": 21,
    "rotation": -90,
    "center": [450, 300.842],
    "outerRadius": 150.842,
    "innerRadius": 75.421,
    "boundingBoxHeight": 299.999,
    "heightToFlagHeight": 0.5,
    "outerDiameterToFlagHeight": 0.50281,
    "innerToOuter": 0.5,
    "construction": [
      "A 21-point star polygon, the first outer vertex pointing straight up (rotation -90 degrees).",
      "Its height (top vertex to the two lowest outer vertices) is R (1 + cos(pi/21)) = 300, half the flag height, so R = 300 / (1 + cos(pi/21)) = 150.842.",
      "The inner radius is half the outer radius.",
      "The centre is (450, 300.842): horizontally centred and offset down by 0.842 so that the star spans y = 150 to y = 450, centred on the flag."
    ]
  },
  "contrast": [
    { "pair": ["red", "white"], "ratio": 4.35 },
    { "pair": ["red", "green"], "ratio": 1.04 },
    { "pair": ["red", "yellow"], "ratio": 2.59 },
    { "pair": ["white", "green"], "ratio": 4.17 },
    { "pair": ["white", "yellow"], "ratio": 1.68 },
    { "pair": ["green", "yellow"], "ratio": 2.48 }
  ],
  "variants": [
