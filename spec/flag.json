      "kurdish": { "kmr": "kesk", "status": "needs-native-review" },
      "hex": "#278E43",
      "rgb": [39, 142, 67],
      "hsl": [136.3, 56.9, 35.5],
      "oklch": [0.571, 0.145, 148.3],
      "cmyk": [73, 0, 53, 44],
      "pantone": {
