{
  "name": "@0xdolan/deq-core",
  "version": "0.0.0",
  "description": "Deq shape geometry, renderer and options (pure, no DOM).",
  "license": "GPL-3.0-or-later",
  "author": "0xdolan <0xdolan@gmail.com>",
  "homepage": "https://0xdolan.github.io/deq/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xdolan/deq.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/0xdolan/deq/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "generate": "node scripts/generate-shapes.ts",
    "fixtures": "tsc -p tsconfig.build.json && node scripts/fixtures.ts",
    "docs": "node scripts/api-docs.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
